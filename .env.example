# Hugging Face Access Token (required for gated models such as ai4bharat/indic-parler-tts)
# Obtain from https://huggingface.co/settings/tokens
HF_TOKEN=

# Directory where downloaded Hugging Face model weights and tokenizers are cached
HF_HOME=./.hf_cache

# Device selection: auto | cpu | cuda
INDICVOICE_DEVICE=auto

# Optional server configuration
INDICVOICE_HOST=0.0.0.0
INDICVOICE_PORT=8000
